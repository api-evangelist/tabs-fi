            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete category"
        },
        {
          "info": {
            "name": "List classes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tabsplatform.com/classes"
          },
          "docs": "List classes"
        }
      ]
    }
  ],
  "bundled": true
